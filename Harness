async function oaiReq(P,c,msgs){const cfg=c.cfg,T=cfg.tools,model=mdl(c),detail={LOW:'low',MEDIUM:'auto',HIGH:'high'}[cfg.media],official=/api\.openai\.com/.test(P.base||'');
  let sys=sysText(c);if(T.json&&!official)sys+='\n\n[OUTPUT FORMAT] Reply ONLY with valid JSON matching this JSON Schema:\n'+G.schema;
  const out=[{role:'system',content:sys}];
  for(const m of msgs){
    if(m.role==='user'){const imgs=m.parts.filter(p=>p.t==='img'),oth=m.parts.filter(p=>p.t==='media');
      let txt=plain(m.parts);if(oth.length)txt+=(txt?'\n\n':'')+oth.map(p=>'[вложение «'+p.name+'» не поддерживается этим API]').join('\n');
      if(imgs.length){const ct=[];if(txt)ct.push({type:'text',text:txt});for(const p of imgs){const d=await bB64(p.id);if(d)ct.push({type:'image_url',image_url:{url:'data:'+p.mime+';base64,'+d,detail}})}out.push({role:'user',content:ct})}
      else if(txt)out.push({role:'user',content:txt})}
    else if(m.role==='assistant'){const calls=m.parts.filter(p=>p.t==='call'),txt=plain(m.parts);if(!txt&&!calls.length)continue;
      const o={role:'assistant',content:txt||null};if(calls.length)o.tool_calls=calls.map(x=>({id:x.id,type:'function',function:{name:x.name,arguments:JSON.stringify(x.args||{})}}));out.push(o)}
    else for(const p of m.parts)if(p.t==='resp')out.push({role:'tool',tool_call_id:p.id,content:JSON.stringify(p.result)})}
  const b={model,messages:out,stream:true,stream_options:{include_usage:true}};
  if(P.reason==='effort'&&cfg.think!=='OFF')b.reasoning_effort=cfg.think.toLowerCase();
  if(P.reason==='qwen'){b.enable_thinking=cfg.think!=='OFF';if(cfg.think!=='OFF')b.thinking_budget={LOW:1024,MEDIUM:8192,HIGH:24576}[cfg.think]}
  if(T.svc&&svcs().length)b.tools=svcs().map(s=>({type:'function',function:svcDecl(s)}));
  if(T.json){let sc;try{sc=JSON.parse(G.schema)}catch{throw new Error(tr('badSchema'))}
    b.response_format=official?{type:'json_schema',json_schema:{name:'response',schema:sc,strict:false}}:{type:'json_object'}}
  Object.assign(b,parseJ(P.extra));
  return{url:baseOf(P)+'/chat/completions',headers:{Authorization:'Bearer '+P.key},body:b}}
async function oaiRead(r,m,upd){const tc={};
  for await(const ch of sse(r)){
    if(ch.error)throw new Error(ch.error.message||JSON.stringify(ch.error));
    const c=ch.choices?.[0],d=c?.delta;
    if(d){const rs=d.reasoning_content??d.reasoning;if(rs)addTxt(m,'think',rs);if(d.content)addTxt(m,'text',d.content);
      for(const t of d.tool_calls||[]){const k=t.index??0,o=tc[k]||(tc[k]={id:'',name:'',a:''});if(t.id)o.id=t.id;if(t.function?.name)o.name+=t.function.name;if(t.function?.arguments)o.a+=t.function.arguments}}
    if(c?.finish_reason&&!['stop','tool_calls'].includes(c.finish_reason))m.fin=c.finish_reason;
    const u=ch.usage||c?.usage;if(u)m.usage={p:u.prompt_tokens||0,o:u.completion_tokens||0,t:u.total_tokens||0};
    upd()}
  for(const o of Object.values(tc)){let a={};try{a=JSON.parse(o.a||'{}')}catch{}m.parts.push({t:'call',id:o.id||uid(),name:o.name,args:a})}}

/* ----- Anthropic (Claude) ----- */
async function claReq(P,c,msgs){const cfg=c.cfg,T=cfg.tools,model=mdl(c),out=[],budget={LOW:1024,MEDIUM:8192,HIGH:24576}[cfg.think];
  const lu=msgs.map(x=>x.role).lastIndexOf('user');/* мысли отправляем только внутри текущего цикла вызова инструментов — API Claude требует их там; из прошлых ответов они в контекст не попадают */
  for(const[mi,m]of msgs.entries()){const role=m.role==='assistant'?'assistant':'user',ct=[],keepTh=m.role==='assistant'&&mi>lu;
    for(const p of m.parts){
      if(p.t==='text'||p.t==='file'||p.t==='code'||p.t==='result'){const x=plain([p]);if(x.trim())ct.push({type:'text',text:x})}
      else if(p.t==='img'){if(/^image\/(jpeg|png|gif|webp)$/.test(p.mime)){const d=await bB64(p.id);if(d)ct.push({type:'image',source:{type:'base64',media_type:p.mime,data:d}})}else ct.push({type:'text',text:'[изображение '+p.mime+' не поддерживается]'})}
      else if(p.t==='media'){if(p.mime==='application/pdf'){const d=await bB64(p.id);if(d)ct.push({type:'document',source:{type:'base64',media_type:p.mime,data:d}})}else ct.push({type:'text',text:'[вложение «'+p.name+'» не поддерживается этим API]'})}
      else if(p.t==='think'){if(budget&&keepTh){if(p.sig)ct.push({type:'thinking',thinking:p.text,signature:p.sig});else if(p.red)ct.push({type:'redacted_thinking',data:p.red})}}
      else if(p.t==='call')ct.push({type:'tool_use',id:p.id,name:p.name,input:p.args||{}});
      else if(p.t==='resp')ct.push({type:'tool_result',tool_use_id:p.id,content:JSON.stringify(p.result),...(p.result?.error?{is_error:true}:{})})}
    if(!ct.length)continue;const l=out[out.length-1];if(l&&l.role===role)l.content.push(...ct);else out.push({role,content:ct})}
  if(out[0]?.role==='assistant')out.unshift({role:'user',content:[{type:'text',text:'(продолжение диалога)'}]});
  const sys=sysText(c)+(T.json?'\n\n[OUTPUT FORMAT] Reply ONLY with valid JSON matching this JSON Schema:\n'+G.schema:'');
  const b={model,max_tokens:budget?budget+16000:16000,system:sys,messages:out,stream:true};
  if(budget)b.thinking={type:'enabled',budget_tokens:budget};
  if(T.svc&&svcs().length)b.tools=svcs().map(s=>{const d=svcDecl(s);return{name:d.name,description:d.description,input_schema:d.parameters}});
  Object.assign(b,parseJ(P.extra));
  return{url:baseOf(P)+'/messages',headers:{'x-api-key':P.key,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},body:b}}
async function claRead(r,m,upd){const bl={};let ui=0,uo=0;
  for await(const ev of sse(r)){
    switch(ev.type){
      case 'error':throw new Error(ev.error?.message||'API error');
      case 'message_start':{const u=ev.message?.usage||{};ui=(u.input_tokens||0)+(u.cache_creation_input_tokens||0)+(u.cache_read_input_tokens||0);uo=u.output_tokens||0;break}
      case 'content_block_start':{const b=ev.content_block;let p=null;
        if(b.type==='text')p={t:'text',text:b.text||''};
        else if(b.type==='thinking')p={t:'think',text:b.thinking||''};
        else if(b.type==='redacted_thinking')p={t:'think',text:'',red:b.data};
        else if(b.type==='tool_use')p={t:'call',id:b.id,name:b.name,args:{},_j:''};
        if(p){m.parts.push(p);bl[ev.index]=p}break}
      case 'content_block_delta':{const d=ev.delta,p=bl[ev.index];if(!p)break;
        if(d.type==='text_delta')p.text+=d.text;else if(d.type==='thinking_delta')p.text+=d.thinking;
        else if(d.type==='signature_delta')p.sig=d.signature;else if(d.type==='input_json_delta')p._j+=d.partial_json;break}
      case 'content_block_stop':{const p=bl[ev.index];if(p&&p._j!==undefined){try{p.args=JSON.parse(p._j||'{}')}catch{}delete p._j}break}
      case 'message_delta':{if(ev.usage?.output_tokens!=null)uo=ev.usage.output_tokens;const sr=ev.delta?.stop_reason;if(sr&&!['end_turn','tool_use','stop_sequence'].includes(sr))m.fin=sr;break}}
    m.usage={p:ui,o:uo,t:ui+uo};upd()}}
const AD={gemini:{req:gemReq,read:gemRead},openai:{req:oaiReq,read:oaiRead},anthropic:{req:claReq,read:claRead}};

/* разовый запрос без стриминга (сжатие, предложение фактов) */
async function once(p,schema,c=C){const P=curP(c),model=mdl(c);if(!P?.key)throw new Error(tr('noKey'));if(!model)throw new Error(tr('noModel'));
  const sc=schema?'\n\nВерни ТОЛЬКО валидный JSON по схеме: '+JSON.stringify(schema):'';
  if(P.type==='gemini'){const g={},th=gth({think:'LOW'},model);if(th){delete th.includeThoughts;g.thinkingConfig=th}
    if(schema){g.responseMimeType='application/json';g.responseJsonSchema=schema}
    const j=await(await api(baseOf(P)+'/models/'+encodeURIComponent(model)+':generateContent',{'x-goog-api-key':P.key},{contents:[{role:'user',parts:[{text:p}]}],generationConfig:g})).json();
    return(j.candidates?.[0]?.content?.parts||[]).filter(x=>!x.thought).map(x=>x.text||'').join('')}
  if(P.type==='anthropic'){const j=await(await api(baseOf(P)+'/messages',{'x-api-key':P.key,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},{model,max_tokens:4096,messages:[{role:'user',content:p+sc}]})).json();
    return(j.content||[]).filter(x=>x.type==='text').map(x=>x.text).join('')}
  const b={model,messages:[{role:'user',content:p+sc}]};if(schema)b.response_format={type:'json_object'};if(P.reason==='qwen')b.enable_thinking=false;
  const j=await(await api(baseOf(P)+'/chat/completions',{Authorization:'Bearer '+P.key},b)).json();
  return j.choices?.[0]?.message?.content||''}

/* ---------- сервисы-инструменты (картинки) ---------- */
function lastImg(c){for(let i=c.msgs.length-1;i>=0;i--){const m=c.msgs[i],a=[...m.parts.filter(p=>p.t==='img'),...m.parts.flatMap(p=>p.t==='resp'?p.imgs||[]:[])];if(a.length)return a[a.length-1]}return null}
async function runSvc(sv,a,c,sig){
  const P=prof(sv.pid);if(!P?.key)throw new Error(tr('noKeyProf',P?.name||'?'));
  const prompt=String(a?.prompt||'').trim();if(!prompt)throw new Error(tr('emptyPrompt'));
  const ar=ARS.includes(a.aspect_ratio)?a.aspect_ratio:'1:1',ref=a.edit_last_image?lastImg(c):null,ex=parseJ(sv.extra),imgs=[];let text='';
  if(sv.kind==='gemini'){
    const parts=[{text:prompt}];if(ref){const d=await bB64(ref.id);if(d)parts.push({inlineData:{mimeType:ref.mime,data:d}})}
    const r=await api(baseOf(P)+'/models/'+encodeURIComponent(sv.model)+':generateContent',{'x-goog-api-key':P.key},{contents:[{role:'user',parts}],generationConfig:{responseModalities:['TEXT','IMAGE'],imageConfig:{aspectRatio:ar,...ex}}},sig);
    const j=await r.json();
    for(const p of j.candidates?.[0]?.content?.parts||[]){if(p.inlineData&&!p.thought)imgs.push({t:'img',id:await putB64(p.inlineData.data,p.inlineData.mimeType,'image'),mime:p.inlineData.mimeType});else if(p.text&&!p.thought)text+=p.text}
    if(!imgs.length)throw new Error(text||j.candidates?.[0]?.finishReason||j.promptFeedback?.blockReason||tr('noImgModel'))}
  else{
    const dalle=/dall-e/.test(sv.model),size={'1:1':'1024x1024','16:9':'1536x1024','4:3':'1536x1024','3:2':'1536x1024','9:16':'1024x1536','3:4':'1024x1536','2:3':'1024x1536'}[ar]||'1024x1024',q={LOW:'low',MEDIUM:'medium',HIGH:'high'}[c.cfg.media];
    let r;
    if(ref&&!dalle){const fd=new FormData();fd.append('model',sv.model);fd.append('prompt',prompt);fd.append('size',size);fd.append('quality',q);
      fd.append('image[]',new Blob([await bBuf(ref.id)],{type:ref.mime}),'image.'+((ref.mime||'image/png').split('/')[1]||'png'));
      try{r=await fetch(baseOf(P)+'/images/edits',{method:'POST',signal:sig,headers:{Authorization:'Bearer '+P.key},body:fd})}catch(e){if(e.name==='AbortError')throw e;throw new Error(tr('netCors'))}
      if(!r.ok)throw await errOf(r)}
    else{const b={model:sv.model,prompt,n:1,...(dalle?{response_format:'b64_json'}:{size,quality:q}),...ex};r=await api(baseOf(P)+'/images/generations',{Authorization:'Bearer '+P.key},b,sig)}
    const j=await r.json();
    for(const d of j.data||[]){if(d.b64_json)imgs.push({t:'img',id:await putB64(d.b64_json,'image/png','image'),mime:'image/png'});
      else if(d.url){const x=await fetch(d.url,{signal:sig}),bl=await x.blob();imgs.push({t:'img',id:await putBuf(await bl.arrayBuffer(),bl.type||'image/png','image'),mime:bl.type||'image/png'})}}
    if(!imgs.length)throw new Error(tr('noImgSvc'))}
  return{imgs,text}}

/* ---------- generation loop ---------- */
async function run(){
  const CH=C,P=curP(CH);
  if(!P?.key){sys(tr('noKeyOpen',P?.name||'?'),1);return}
  if(!mdl(CH)){sys(tr('noModelTap'),1);return}
  busy=1;ctrl=new AbortController();setBusy(true);
  let raf=0;const sched=(el,m)=>{if(raf)return;raf=requestAnimationFrame(()=>{raf=0;if(!el.isConnected)return;const nb=chatEl.scrollHeight-chatEl.scrollTop-chatEl.clientHeight<160;paintBody(el,m,true);if(nb)bottom()})};
  try{
    for(let step=0;step<6;step++){
      const m={id:uid(),role:'assistant',parts:[],ts:Date.now(),pid:P.id,model:mdl(CH),json:!!CH.cfg.tools.json};
      CH.msgs.push(m);const el=addEl(m,true);let fail='',ab=0;
      try{
        const msgs=prep(CH.msgs.filter(x=>!x.ar&&x!==m)),q=await AD[P.type].req(P,CH,msgs),r=await api(q.url,q.headers,q.body,ctrl.signal);
        await AD[P.type].read(r,m,()=>sched(el,m))}
      catch(e){if(e.name==='AbortError')ab=1;else fail=e.message}
      if(raf){cancelAnimationFrame(raf);raf=0}
      m.parts=m.parts.filter(p=>p._j===undefined);
      const has=m.parts.some(p=>(p.t==='text'&&p.text)||['call','code','result','img'].includes(p.t));
      if(!has){CH.msgs.pop();el.remove();if(!CH.msgs.length&&C===CH)chatEl.innerHTML=heroHTML();
        if(fail)sys('⚠️ '+fail,1);else if(!ab)sys(tr('emptyReply')+(m.fin?' ('+m.fin+')':''),1);break}
      if(fail)sys('⚠️ '+fail+tr('incomplete'),1);
      else if(m.fin&&!ab)sys(tr('endedEarly')+m.fin,1);
      paintMsg(el,m);CH.ts=Date.now();
      if(m.usage){CH.used=m.usage.t;if(C===CH)syncUI()}
      await save(CH);
      if(fail||ab)break;
      const calls=m.parts.filter(p=>p.t==='call');if(!calls.length)break;
      const tm={id:uid(),role:'tool',parts:[],ts:Date.now(),pend:calls.map(x=>x.name)},tel=addEl(tm);let aborted=0;
      const act_=svcs();
      for(const cl of calls){
        const sv=act_.find(s=>s.fn===cl.name),r={t:'resp',id:cl.id,gid:cl.gid,name:cl.name,args:cl.args,result:null,imgs:[]};
        try{if(!sv)throw new Error(tr('unkFn',cl.name));const o=await runSvc(sv,cl.args,CH,ctrl.signal);r.imgs=o.imgs;
          r.result={status:'ok',note:'Image generated successfully and is already shown to the user.'+(o.text?' Service note: '+o.text:'')}}
        catch(e){if(e.name==='AbortError')aborted=1;r.result={error:aborted?'cancelled by user':e.message}}
        tm.parts.push(r);if(aborted)break}
      delete tm.pend;CH.msgs.push(tm);paintMsg(tel,tm);bottom();await save(CH);
      if(aborted)break}
  }finally{busy=0;ctrl=null;setBusy(false)}
  const lu=[...CH.msgs].reverse().find(x=>x.usage)?.usage?.p||0;
  if(lu>winOf(CH)*.7)compact(CH);
}
const winOf=c=>curP(c)?.win||1e6;
function setBusy(b){$('send').hidden=b;$('stop').hidden=!b}
async function send(){
  if(busy)return;const txt=inp.value.trim();if(!txt&&!att.length)return;
  const P=curP();if(!P?.key){sys(tr('noKeyOpen',P?.name||'?'),1);return}
  const parts=[];if(txt)parts.push({t:'text',text:txt});
  for(const a of att){if(a.ab){const id=await putBuf(a.ab,a.mime,a.name);parts.push({t:/^image\//.test(a.mime)?'img':'media',id,mime:a.mime,name:a.name})}else parts.push({t:'file',name:a.name,text:a.text})}
  const first=!C.msgs.length;att=[];drawAtt();inp.value='';fit(inp);C.draft='';
  const u={id:uid(),role:'user',parts,ts:Date.now()};C.msgs.push(u);C.ts=Date.now();
  if(first&&C.auto){C.title=(txt||parts.find(p=>p.name)?.name||tr('chatFallback')).replace(/\s+/g,' ').slice(0,40);syncUI()}
  addEl(u);await save();await run()}

/* ---------- memory ---------- */
const flat=(m,n)=>({user:'Пользователь',assistant:'Ассистент',tool:'Инструмент'}[m.role])+': '+m.parts.map(p=>p.t==='text'?p.text:p.t==='file'?'[FILE: '+p.name+']\n'+p.text:p.t==='code'?'[код]\n'+p.code:p.t==='result'?'[результат]\n'+p.output:p.t==='call'?'[вызов '+p.name+']':p.t==='resp'?'[результат '+p.name+']':'').filter(Boolean).join('\n').slice(0,n);
async function compact(CH=C,manual){
  const act_=CH.msgs.filter(m=>!m.ar);if(act_.length<8){if(manual)toast(tr('tooShort'));return}
  let cut=Math.floor(act_.length/2);while(cut<act_.length-4&&act_[cut].role!=='user')cut++;
  const old=act_.slice(0,cut);sys(tr('compressing'),1);
  try{const s=await once('Сожми диалог в подробное резюме для продолжения работы: цели, решения, факты, числа, имена, определения, открытые вопросы, принятые и отвергнутые гипотезы. Ничего важного не теряй. Пиши на языке диалога.\n\n'+old.map(m=>flat(m,6000)).join('\n\n'),null,CH);
    CH.sums.push({t:s,ids:old.map(m=>m.id)});old.forEach(m=>m.ar=1);await save(CH);if(C===CH){redraw()}sys(tr('compressed'),1)}
  catch(e){sys(tr('compressFail')+e.message,1)}}
function memView(){const p=$('pins');p.innerHTML='';
  G.pins.forEach((f,i)=>{const d=document.createElement('div'),s=document.createElement('span'),b=document.createElement('button');d.className='pin';s.textContent=f;b.textContent='✕';b.onclick=()=>{G.pins.splice(i,1);saveG();memView()};d.append(s,b);p.appendChild(d)});
  $('sumInfo').textContent=C.sums.length?tr('sumInfo',C.sums.length,C.msgs.filter(m=>m.ar).length,C.msgs.length):tr('noSum');
  $('undo').hidden=!C.sums.length}
function pin(f,quiet){f=String(f||'').trim();if(f&&!G.pins.includes(f)){G.pins.push(f);saveG();if(!quiet)memView()}}
function undo(){const s=C.sums.pop();if(!s)return;const ids=new Set(s.ids);C.msgs.forEach(m=>{if(ids.has(m.id))m.ar=0});save();redraw()}
async function propose(){const box=$('cand');box.textContent='…';
  try{const t=C.msgs.filter(m=>!m.ar).slice(-10).map(m=>flat(m,3000)).join('\n\n');
    const a=jparse(await once('Выдели из диалога устойчивые факты, решения и предпочтения пользователя, которые стоит закрепить в долгой памяти. Уже закреплено:\n'+(G.pins.join('\n')||'—')+'\n\nДиалог:\n'+t+'\n\nВерни JSON-массив коротких строк (до 8), без дублей.',{type:'array',items:{type:'string'}}));
    box.innerHTML='';(Array.isArray(a)?a:[]).forEach(f=>{const b=document.createElement('button');b.className='cd';b.textContent='＋ '+f;b.onclick=()=>{pin(f);b.remove()};box.appendChild(b)});if(!box.children.length)box.textContent=tr('nothingAdd');
  }catch(e){box.textContent='⚠️ '+e.message}}
async function exp(md){
  const dl=(n,b)=>{const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=n;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),4000)};
  const base=(ttlOf(C)||'chat').replace(/[^\wа-яё\- ]+/gi,'').trim().replace(/\s+/g,'_')||'chat';
  if(md){const t=C.msgs.map(m=>m.role==='tool'?'':'## '+(m.role==='user'?tr('you'):(prof(m.pid)?.name||'AI')+' · '+(m.model||''))+'\n\n'+txtOf(m)).filter(Boolean).join('\n\n');
    dl(base+'.md',new Blob(['# '+ttlOf(C)+'\n\n'+t],{type:'text/markdown'}))}
  else{const bl={};for(const id of blobIds(C.msgs)){const r=await kvGet('blobs',id);if(r)bl[id]={mime:r.mime,name:r.name,b:buf2b(r.ab)}}
    dl(base+'.json',new Blob([JSON.stringify({v:2,chat:C,pins:G.pins,blobs:bl})],{type:'application/json'}))}}
async function fromLegacy(o){const c=newChatObj();c.title=tr('importedChat');c.auto=0;c.cfg.pid=G.profiles.find(p=>p.type==='gemini')?.id||G.profiles[0].id;c.cfg.model='';
  (o.pins||[]).forEach(x=>pin(x,1));
  for(const m of o.msgs||[]){const n={id:uid(),role:m.role==='user'?'user':'assistant',parts:[],ts:Date.now()};if(m.ar)n.ar=1;if(m.json)n.json=1;if(m.g)n.g=m.g;if(m.u)n.u=m.u;if(m.fin)n.fin=m.fin;
    if(n.role==='assistant'){n.pid=c.cfg.pid;n.model='gemini'}
    if(m.usage)n.usage={p:m.usage.promptTokenCount||0,o:m.usage.candidatesTokenCount||0,t:m.usage.totalTokenCount||0};
    for(const p of m.parts||[]){
      if(p.thought&&p.text!==undefined)n.parts.push({t:'think',text:p.text});
      else if(p.text!==undefined){const f=n.role==='user'&&/^\[FILE: (.+?)\]\n([\s\S]*)$/.exec(p.text);if(f)n.parts.push({t:'file',name:f[1],text:f[2]});else n.parts.push(p.thoughtSignature?{t:'text',text:p.text,sig:p.thoughtSignature}:{t:'text',text:p.text})}
      else if(p.inlineData){const id=await putB64(p.inlineData.data,p.inlineData.mimeType,tr('file'));n.parts.push({t:/^image\//.test(p.inlineData.mimeType)?'img':'media',id,mime:p.inlineData.mimeType,name:tr('file')})}
      else if(p.executableCode)n.parts.push({t:'code',lang:p.executableCode.language,code:p.executableCode.code});
      else if(p.codeExecutionResult)n.parts.push({t:'result',outcome:p.codeExecutionResult.outcome,output:p.codeExecutionResult.output||''})}
    if(n.parts.length)c.msgs.push(n)}
  c.sums=(o.sums||[]).map(s=>({t:s.t,ids:(s.ids||[]).map(i=>o.msgs[i]&&c.msgs[i]?.id).filter(Boolean)}));
  const f=c.msgs.find(m=>m.role==='user');if(f)c.title=(txtOf(f)||tr('chatFallback')).slice(0,40);return c}
async function imp(e){const f=e.target.files[0];e.target.value='';if(!f)return;
  try{const o=JSON.parse(await f.text());let c;
    if(o.v===2&&o.chat){c=o.chat;const map={};for(const[id,b]of Object.entries(o.blobs||{}))map[id]=await putB64(b.b,b.mime,b.name);
      for(const m of c.msgs)for(const p of m.parts){if((p.t==='img'||p.t==='media')&&map[p.id])p.id=map[p.id];if(p.t==='resp')(p.imgs||[]).forEach(i=>{if(map[i.id])i.id=map[i.id]})}
      c.id=uid();(o.pins||[]).forEach(x=>pin(x,1))}
    else c=await fromLegacy(o);
    c.cfg=Object.assign(mkCfg(),c.cfg||{});c.cfg.tools=c.cfg.tools||{};if(!prof(c.cfg.pid))c.cfg.pid=G.profiles[0].id;c.msgs=c.msgs||[];c.sums=c.sums||[];
    await save(c);await setChat(c);ov('mem',0);toast(tr('imported'))}
  catch(err){sys(tr('readFail')+err.message,1)}}
