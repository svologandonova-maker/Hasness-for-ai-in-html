/* IndexedDB: соединение может закрыть браузер (фон в iOS Safari, смена версии в другой вкладке, очистка данных).
   Поэтому соединение не кэшируем навсегда: при закрытии открываем заново и повторяем операцию один раз. */
let IDB=null,OPENING=null;
function openIDB(){
  if(IDB)return Promise.resolve(IDB);
  if(OPENING)return OPENING;
  OPENING=new Promise(ok=>{try{
    const r=indexedDB.open('harness',2);
    r.onupgradeneeded=()=>{const d=r.result;['kv','chats','blobs'].forEach(n=>{if(!d.objectStoreNames.contains(n))d.createObjectStore(n)})};
    r.onsuccess=()=>{const d=r.result;d.onclose=()=>{if(IDB===d)IDB=null};d.onversionchange=()=>{try{d.close()}catch{}if(IDB===d)IDB=null};IDB=d;OPENING=null;ok(d)};
    r.onerror=()=>{OPENING=null;ok(null)};
    r.onblocked=()=>{OPENING=null;ok(null)}
  }catch{OPENING=null;ok(null)}});
  return OPENING}
const idb={then:(f,r)=>openIDB().then(f,r)};
/* одна операция над хранилищем; при закрытом соединении — переоткрыть и повторить; если не вышло — в память (MEM) и сообщить */
function kvRun(st,mode,fn,mem,again=1){
  return openIDB().then(d=>{
    if(!d)return mem();
    return new Promise(ok=>{
      let q;
      try{const t=d.transaction(st,mode);q=fn(t.objectStore(st));
        t.oncomplete=()=>ok({v:q?q.result:undefined});
        t.onerror=t.onabort=()=>ok({v:undefined})}
      catch{ok({retry:1})}
    }).then(r=>{
      if(!r.retry)return r.v;
      IDB=null;
      if(again)return kvRun(st,mode,fn,mem,0);
      console.error('IndexedDB недоступна, данные сохранены только в памяти до перезагрузки');
      return mem()})})}
const kvGet=(st,k)=>kvRun(st,'readonly',s=>s.get(k),()=>MEM.get(st+k));
const kvSet=(st,k,v)=>kvRun(st,'readwrite',s=>s.put(v,k),()=>{MEM.set(st+k,v)});
const kvDel=(st,k)=>kvRun(st,'readwrite',s=>s.delete(k),()=>{MEM.delete(st+k)});

const b2buf=b=>{const s=atob(b),u=new Uint8Array(s.length);for(let i=0;i<s.length;i++)u[i]=s.charCodeAt(i);return u.buffer};
const buf2b=ab=>{const u=new Uint8Array(ab);let s='';for(let i=0;i<u.length;i+=0x8000)s+=String.fromCharCode.apply(null,u.subarray(i,i+0x8000));return btoa(s)};
