/* ---------- вложения ---------- */
const loadImg=f=>new Promise((ok,no)=>{const u=URL.createObjectURL(f),i=new Image();i.onload=()=>{URL.revokeObjectURL(u);ok(i)};i.onerror=()=>{URL.revokeObjectURL(u);no()};i.src=u});
async function shrink(f){const q=C.cfg.media,lim={LOW:768,MEDIUM:1568,HIGH:2560}[q];
  if(!/^image\/(jpeg|png|webp)$/.test(f.type))return null;
  try{const i=await loadImg(f),sc=Math.min(1,lim/Math.max(i.naturalWidth,i.naturalHeight));
    if(sc>=1&&f.size<=(q==='HIGH'?8e6:1.5e6))return null;
    const cv=document.createElement('canvas');cv.width=Math.max(1,Math.round(i.naturalWidth*sc));cv.height=Math.max(1,Math.round(i.naturalHeight*sc));
    const x=cv.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,cv.width,cv.height);x.drawImage(i,0,0,cv.width,cv.height);
    const bl=await new Promise(r=>cv.toBlob(r,'image/jpeg',{LOW:.6,MEDIUM:.8,HIGH:.92}[q]));
    return bl&&bl.size<f.size?bl:null}catch{return null}}
async function addFiles(fs){for(const f of fs){
  if(f.size>15e6){sys(tr('tooBig',f.name),1);continue}
  const bin=/^(image|audio|video)\//.test(f.type)||f.type==='application/pdf';
  try{if(bin){let bl=f,mime=f.type,name=f.name;if(/^image\//.test(f.type)){const s=await shrink(f);if(s){bl=s;mime='image/jpeg';name=name.replace(/\.\w+$/,'')+'.jpg'}}
      att.push({name,mime,ab:await bl.arrayBuffer()})}
    else att.push({name:f.name,text:await f.text()})}catch{sys(tr('readFailFile',f.name),1)}
  drawAtt()}}
const pick=e=>{addFiles([...e.target.files]);e.target.value=''};
function drawAtt(){const p=$('att');p.innerHTML='';
  att.forEach((a,i)=>{const c=document.createElement('span'),x=document.createElement('b');c.className='chip';c.textContent='@'+a.name;x.textContent='✕';x.onclick=()=>{att.splice(i,1);drawAtt()};c.appendChild(x);p.appendChild(c)})}
inp.addEventListener('paste',e=>{const fs=[...(e.clipboardData?.files||[])];if(fs.length){e.preventDefault();addFiles(fs)}});
const touch=matchMedia('(pointer:coarse)').matches;
inp.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey&&!touch){e.preventDefault();send()}});
function locate(){navigator.geolocation?.getCurrentPosition(p=>{LOC={latitude:p.coords.latitude,longitude:p.coords.longitude}},()=>{})}

