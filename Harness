/* ---------- init ---------- */
async function boot(){
  try{navigator.storage?.persist?.()}catch{}
  let g=null;try{g=JSON.parse(localStorage.getItem('H2')||'null')}catch{}
  if(!g)g=await kvGet('kv','G');
  if(!g){g=freshG();
    try{const o=JSON.parse(localStorage.getItem('H_CFG')||'null');
      if(o){const p=g.profiles[0];p.key=o.key||'';p.model=o.model||p.model;p.win=o.win||p.win;g.rules=o.rules||g.rules;g.schema=o.schema||g.schema;
        g.last.think=o.think||'MEDIUM';g.last.tools=Object.fromEntries(Object.entries(o.tools||{}).map(([k,v])=>[k,+v]))}}catch{}}
  G=g;G.lang=G.lang||'auto';delete G.thinkAlways;applyStatic();G.profiles=G.profiles?.length?G.profiles:freshG().profiles;G.services=G.services||[];G.pins=G.pins||[];G.last=G.last||{};
  if(!prof(G.last.pid))G.last.pid=G.profiles[0].id;G.last.think=G.last.think||'MEDIUM';G.last.media=G.last.media||'MEDIUM';G.last.tools=G.last.tools||{};
  IDX=(await kvGet('kv','idx'))||[];
  if(!IDX.length){const old=await kvGet('kv','chat');
    if(old?.msgs?.length){const c=await fromLegacy(old);await save(c);G.cur=c.id}}
  let c=null;const id=IDX.some(x=>x.id===G.cur)?G.cur:IDX.slice().sort((a,b)=>b.ts-a.ts)[0]?.id;
  if(id)c=await loadChat(id);
  if(!c){c=newChatObj();await save(c)}
  C=c;G.cur=c.id;saveG();inp.value=c.draft||'';fit(inp);
  if(!prof(C.cfg.pid))C.cfg.pid=G.profiles[0].id;
  redraw();
  if(G.last.tools?.maps)locate();
  if(!G.profiles.some(p=>p.key))sys(tr('addKey'),1)}
window.addEventListener('load',boot);
window.addEventListener('pagehide',()=>{if(C){C.draft=inp.value;save()}});
