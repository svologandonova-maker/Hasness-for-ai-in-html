function render(text){
  if(!window.marked||!window.DOMPurify)return esc(text).replace(/\n/g,'<br>');
  const M=[],put=(t,d)=>{M.push([t,d]);return '@@M'+(M.length-1)+'@@'};
  const s=text.split(/(```[\s\S]*?```|`[^`\n]*`)/).map((x,i)=>i%2?x:x
    .replace(/\$\$([\s\S]+?)\$\$/g,(_,t)=>put(t,1))
    .replace(/\\\[([\s\S]+?)\\\]/g,(_,t)=>put(t,1))
    .replace(/\\\(([\s\S]+?)\\\)/g,(_,t)=>put(t,0))
    .replace(/(?<![\\$\d])\$(?!\s)([^$\n]+?)(?<!\s)\$(?!\d)/g,(_,t)=>put(t,0))).join('');
  const h=DOMPurify.sanitize(marked.parse(s,{breaks:true,gfm:true})).replace(/<a /g,'<a target="_blank" rel="noopener" ');
  return h.replace(/@@M(\d+)@@/g,(_,i)=>{const[t,d]=M[i];let r;
    try{r=window.katex?katex.renderToString(t,{displayMode:!!d,throwOnError:false}):esc(t)}catch{r=esc(t)}
    return '<span class="mx'+(d?' blk':'')+'" data-tex="'+encodeURIComponent(d?'$$'+t+'$$':'$'+t+'$')+'">'+r+'</span>'});
}
