<style>
:root{--bg:#0b0e14;--s1:#121722;--s2:#1a2130;--s3:#252f44;--bd:#2b3549;--tx:#e8edf7;--mu:#8e9ab2;--ac:#7c9cff;--ac2:#b07cff;--ok:#2fbf71;--er:#ff6b6b;--g:linear-gradient(135deg,#6f8cff,#a46bff)}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
[hidden]{display:none!important}
html{background:var(--bg)}
body{background:radial-gradient(900px 480px at 0% -8%,#1b2447 0,transparent 60%),radial-gradient(700px 420px at 100% 0,#2a1c47 0,transparent 55%),var(--bg);color:var(--tx);font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;display:flex;flex-direction:column;height:100dvh;overflow:hidden;padding-top:env(safe-area-inset-top)}
header{display:flex;align-items:center;gap:4px;padding:6px 8px;background:#121722d9;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--bd);z-index:2}
.hd{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px;cursor:pointer;padding:0 4px}
.hd b{font-size:.98rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sub{display:flex;gap:6px;overflow:hidden}
.bd{font-size:.7rem;padding:0 8px;border-radius:10px;background:var(--s2);border:1px solid var(--bd);color:var(--mu);white-space:nowrap}
button{background:var(--s2);border:1px solid var(--bd);color:var(--tx);padding:0 14px;min-height:42px;border-radius:12px;font:inherit;font-size:.9rem;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;transition:background .15s,transform .1s}
button:active{background:var(--s3);transform:scale(.98)}
.ib{min-width:40px;padding:0;font-size:1.1rem;background:transparent;border-color:transparent}
.pri{background:var(--g);border-color:transparent;color:#fff;font-weight:600}
.stop{background:var(--er);border-color:transparent;color:#fff}
.dng{color:var(--er)}
select,input,textarea{background:var(--s1);border:1px solid var(--bd);color:var(--tx);border-radius:12px;padding:9px 11px;font:inherit;font-size:16px;outline:none;min-height:42px;width:100%}
select:focus,input:focus,textarea:focus{border-color:var(--ac)}
input[type=checkbox],input[type=radio]{width:auto;min-height:0}
textarea{resize:none}
#chat{flex:1;overflow-y:auto;padding:14px 12px 8px;display:flex;flex-direction:column;gap:14px;overscroll-behavior:contain}
.m{font-size:.97rem;word-break:break-word;animation:in .2s ease}
@keyframes in{from{opacity:0;transform:translateY(6px)}}
.m.arch{opacity:.5}
.m.u{align-self:flex-end;max-width:90%;display:flex;flex-direction:column;align-items:flex-end;gap:2px}
.bub{background:var(--g);color:#fff;padding:9px 14px;border-radius:18px 18px 4px 18px;box-shadow:0 4px 18px #6f8cff30}
.ut{white-space:pre-wrap}
.atts{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.atts img,.b img,.tc img{max-width:min(100%,260px);max-height:260px;border-radius:12px;object-fit:cover;cursor:zoom-in;display:block;margin:6px 0}
.atts img{max-width:150px;max-height:150px;margin:0}
.chip{background:#0003;border:1px solid #fff2;border-radius:8px;font-size:.78rem;padding:2px 8px}
.m.a{align-self:stretch}.m.t{align-self:stretch}
.who{display:flex;align-items:center;gap:7px;font-size:.76rem;color:var(--mu);margin-bottom:4px}
.av{width:10px;height:10px;border-radius:50%;display:inline-block;flex:none}
.tk{margin-left:auto;font-size:.7rem;opacity:.8}
.act{display:flex;gap:2px;margin-top:2px}
.m.u .act{justify-content:flex-end}
.act button{min-height:30px;min-width:34px;padding:0 8px;background:none;border:0;color:var(--mu);font-size:.95rem;opacity:.75}
.act button:active{background:var(--s2)}
.s{align-self:center;font-size:.8rem;color:var(--mu);text-align:center;background:var(--s1);border:1px solid var(--bd);border-radius:12px;padding:6px 12px;max-width:94%}
.tc{background:var(--s1);border:1px solid var(--bd);border-radius:14px;padding:8px 12px;font-size:.88rem}
.tn{color:var(--mu)}.tn b{color:var(--tx)}.tc .er{color:var(--er);margin-top:4px}
.tkb{background:#b07cff12;border-left:3px solid var(--ac2);border-radius:0 12px 12px 0;padding:6px 12px;margin-bottom:8px;color:var(--mu);font-size:.88rem;max-height:45vh;overflow-y:auto}
.tkt{display:flex;width:fit-content;gap:8px;min-height:34px;margin-bottom:8px;padding:0 12px;border-radius:8px;font-size:.82rem;color:var(--ac2);background:#b07cff14;border-color:#b07cff40}
.tkt[aria-expanded=true]{background:#b07cff2b}
.tkt.live{animation:pl 1.4s infinite}
@keyframes pl{50%{opacity:.5}}
.hero{margin:auto;text-align:center;color:var(--mu);padding:20px;display:flex;flex-direction:column;gap:8px;align-items:center}
.hero .lg{font-size:2.2rem}.hero b{color:var(--tx);font-size:1.1rem}.hero p{font-size:.88rem;max-width:300px}
.b p,.b ul,.b ol,.b pre,.b table,.b blockquote,.b details{margin:.5em 0}.b ul,.b ol{padding-left:1.4em}
.b h1,.b h2,.b h3{font-size:1.05rem;margin:.8em 0 .3em}
.b a{color:var(--ac)}
.b blockquote{border-left:3px solid var(--bd);padding-left:10px;color:var(--mu)}
.b table{border-collapse:collapse;display:block;overflow-x:auto}.b td,.b th{border:1px solid var(--bd);padding:4px 8px}
.b code{font-family:ui-monospace,Menlo,monospace;font-size:.85em}
.b :not(pre)>code{background:var(--s2);padding:1px 5px;border-radius:4px}
.b pre{position:relative;background:var(--s1);border:1px solid var(--bd);border-radius:12px;padding:10px;overflow-x:auto}
.cp{position:absolute;top:4px;right:4px;min-height:30px;padding:0 8px;opacity:.85}
details{background:var(--s1);border:1px solid var(--bd);border-radius:12px;padding:6px 10px}
summary{cursor:pointer;color:var(--mu);font-size:.85rem}details pre{margin-top:6px}
.src a{display:block;padding:5px 0;font-size:.85rem;color:var(--ac);text-decoration:none;overflow-wrap:anywhere}
.src i{color:var(--mu)}.q{font-size:.8rem;color:var(--mu);padding:4px 0}
.src iframe{width:100%;height:56px;border:0;border-radius:8px;margin-top:6px}
.mx{cursor:pointer}.mx.blk{display:block;overflow-x:auto;margin:.5em 0}
.dots{color:var(--mu);animation:pl 1.2s infinite}
#toast{position:fixed;left:50%;bottom:calc(150px + env(safe-area-inset-bottom));transform:translateX(-50%);background:var(--s3);border:1px solid var(--bd);padding:8px 16px;border-radius:20px;font-size:.85rem;z-index:50;opacity:0;pointer-events:none;transition:opacity .2s;max-width:90vw;text-align:center}
#toast.on{opacity:1}
.fb{padding:6px 10px calc(8px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:6px;background:linear-gradient(#0b0e1400,#0b0e14 28%)}
.tools{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;align-items:center}
.tools::-webkit-scrollbar{display:none}
#tg{display:contents}
.pill{display:flex;align-items:center;gap:6px;background:var(--s2);border:1px solid var(--bd);border-radius:20px;padding:0 11px;min-height:34px;font-size:.8rem;color:var(--tx);white-space:nowrap;flex:none}
.pill select{border:0;background:none;color:var(--tx);min-height:30px;padding:0;font-size:.8rem;width:auto}
.pill.mp{font-weight:600}
.tgb{min-height:34px;border-radius:20px;font-size:.8rem;color:var(--mu);padding:0 11px;flex:none;white-space:nowrap}
.tgb.on{background:#7c9cff22;border-color:var(--ac);color:var(--ac)}
.att{display:flex;gap:6px;flex-wrap:wrap}
.att .chip{background:var(--s2);border-color:var(--bd);color:var(--ac)}.att .chip b{color:var(--er);padding-left:8px;cursor:pointer}
.cmp{display:flex;align-items:flex-end;gap:4px;background:var(--s1);border:1px solid var(--bd);border-radius:24px;padding:4px;box-shadow:0 6px 28px #0008}
.cmp textarea{border:0;background:transparent;min-height:40px;max-height:140px;padding:9px 6px;flex:1;border-radius:0}
.cmp button{width:42px;min-width:42px;height:42px;min-height:42px;border-radius:50%;padding:0;font-size:1.05rem}
.ov{position:fixed;inset:0;background:#000a;z-index:20;display:none;align-items:flex-end;backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px)}
.ov.open{display:flex}.ov.z2{z-index:30}
.sh{background:var(--s1);border-top:1px solid var(--bd);width:100%;max-height:90dvh;overflow-y:auto;border-radius:22px 22px 0 0;padding:16px 14px calc(16px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:12px;animation:up .22s ease}
@keyframes up{from{transform:translateY(40px);opacity:.4}}
.sh h3{font-size:1.02rem;display:flex;justify-content:space-between;align-items:center}
.sh label{font-size:.78rem;color:var(--mu);display:flex;flex-direction:column;gap:4px;letter-spacing:.02em}
.sh label.chk{flex-direction:row;align-items:center;gap:8px;font-size:.88rem;color:var(--tx)}
.sec{font-size:.74rem;letter-spacing:.08em;color:var(--ac);margin-top:6px}
.hint{font-size:.8rem;color:var(--mu)}
.card{display:flex;align-items:center;gap:10px;background:var(--s2);border:1px solid var(--bd);border-radius:14px;padding:10px 12px;cursor:pointer;text-align:left}
.card b{font-size:.92rem}.card small{display:block;font-size:.76rem;color:var(--mu)}.card em{margin-left:auto;font-style:normal;font-size:.75rem;color:var(--mu)}
.pin{display:flex;gap:8px;align-items:center;justify-content:space-between;background:var(--bg);border:1px solid var(--bd);border-radius:10px;padding:4px 4px 4px 10px;font-size:.88rem}
.pin button{min-height:32px}
.cd{justify-content:flex-start;text-align:left;width:100%;font-size:.85rem}
.row{display:flex;gap:8px;align-items:center}
.pr{flex-direction:row!important;align-items:center;gap:10px!important;background:var(--s2);border:1px solid var(--bd);border-radius:12px;padding:10px 12px;font-size:.92rem!important;color:var(--tx)!important}
.pr em{font-style:normal;color:var(--er);font-size:.74rem}
.dro{align-items:stretch;justify-content:flex-start}
.dr{width:min(88vw,340px);background:var(--s1);border-right:1px solid var(--bd);display:flex;flex-direction:column;gap:10px;padding:calc(12px + env(safe-area-inset-top)) 12px calc(12px + env(safe-area-inset-bottom));animation:lft .22s ease}
@keyframes lft{from{transform:translateX(-100%)}}
.dh{display:flex;justify-content:space-between;align-items:center}
#cl{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:6px}
.ci{display:flex;align-items:center;gap:8px;padding:8px 6px 8px 10px;border-radius:12px;cursor:pointer;border:1px solid transparent}
.ci.on{background:var(--s2);border-color:var(--bd)}
.ci .cm{flex:1;min-width:0}.ci b{display:block;font-size:.9rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ci span{font-size:.74rem;color:var(--mu)}
.ci button{min-height:32px;min-width:32px;padding:0;background:none;border:0;font-size:.9rem;opacity:.7}
.lb{align-items:center;justify-content:center;flex-direction:column;gap:12px;z-index:40}
.lb img{max-width:96vw;max-height:78dvh;border-radius:12px}
.lb a{color:#fff;background:var(--s3);padding:8px 18px;border-radius:20px;text-decoration:none;font-size:.9rem}
</style>
</head>
<body>
<header>
  <button class="ib" onclick="openDr()">☰</button>
  <div class="hd" onclick="renameChat()"><b id="ttl"></b><div class="sub"><span class="bd" id="mb"></span><span class="bd" id="ctx"></span></div></div>
  <button class="ib" onclick="newChat()">＋</button>
  <button class="ib" onclick="openMem()">🧠</button>
  <button class="ib" onclick="openCfg()">⚙️</button>
</header>
<div id="chat"></div>
<div id="toast"></div>
<div class="fb">
  <div class="tools" id="tools">
    <button class="pill mp" id="mp" onclick="openMP()"></button>
    <label class="pill" title="Thinking" data-ti="thinkLvl">💭<select id="th"><option>OFF</option><option>LOW</option><option>MEDIUM</option><option>HIGH</option></select></label>
    <label class="pill" title="Media quality" data-ti="mediaQ">🖼<select id="mq"><option>LOW</option><option>MEDIUM</option><option>HIGH</option></select></label>
    <span id="tg"></span>
  </div>
  <div class="att" id="att"></div>
  <div class="cmp">
    <button class="ib" onclick="$('fp').click()">📎</button><input type="file" id="fp" multiple hidden onchange="pick(event)">
    <textarea id="inp" rows="1" placeholder="Message…" data-ph="msgPh" oninput="fit(this)"></textarea>
    <button class="pri" id="send" onclick="send()">➤</button>
    <button class="stop" id="stop" hidden onclick="ctrl&&ctrl.abort()">■</button>
  </div>
</div>

<div class="ov dro" id="dro" onclick="if(event.target===this)closeDr()"><aside class="dr">
  <div class="dh"><b data-i="chats">Chats</b><button class="pri" onclick="newChat()" data-i="newBtn">＋ New</button></div>
  <input id="cs" placeholder="Search…" data-ph="search" oninput="drawList()">
  <div id="cl"></div>
</aside></div>

<div class="ov" id="cfg" onclick="if(event.target===this)ov('cfg',0)"><div class="sh" id="cfgb"></div></div>

<div class="ov" id="mem" onclick="if(event.target===this)ov('mem',0)"><div class="sh">
  <h3><span data-i="memory">Memory</span> <button onclick="ov('mem',0)">✕</button></h3>
  <div class="hint" data-i="memHint"></div>
  <div id="pins" style="display:flex;flex-direction:column;gap:6px"></div>
  <div class="row"><input id="np" placeholder="New fact…" data-ph="newFactPh"><button onclick="pin($('np').value);$('np').value=''">＋</button></div>
  <button onclick="propose()" data-i="proposeBtn">💡 Suggest facts from chat</button>
  <div id="cand"></div>
  <div class="hint" id="sumInfo"></div>
  <div class="row"><button onclick="compact(C,1)" style="flex:1" data-i="compactBtn">🗜 Compress now</button><button id="undo" onclick="undo()" style="flex:1" data-i="undoBtn">↩ Undo compression</button></div>
  <div class="row"><button onclick="exp()" style="flex:1">⬇ JSON</button><button onclick="exp(1)" style="flex:1">⬇ Markdown</button><button onclick="$('ip').click()" style="flex:1" data-i="importBtn">⬆ Import</button><input type="file" id="ip" accept=".json" hidden onchange="imp(event)"></div>
  <button class="dng" onclick="clr()" data-i="clearChat">Clear this chat</button>
</div></div>

<div class="ov z2" id="dyn" onclick="if(event.target===this)closeDyn()"><div class="sh" id="dynb"></div></div>
<div class="ov lb" id="lb" onclick="ov('lb',0)"><img id="lbi" alt=""><a id="lba" download="image.png" onclick="event.stopPropagation()" data-i="lbSave">⬇ Save</a></div>

<script>
'use strict';
const $=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid=()=>Math.random().toString(36).slice(2,9)+Date.now().toString(36).slice(-3);
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const chatEl=$('chat'),inp=$('inp');
const kn=n=>n>=1e6?(n/1e6).toFixed(1)+'M':n>=1e3?Math.round(n/1e3)+'k':String(n|0);
const parseJ=s=>{if(!s||!String(s).trim())return{};try{const o=JSON.parse(s);return o&&typeof o==='object'?o:{}}catch{return{}}};
const pretty=s=>{try{return JSON.stringify(JSON.parse(s),null,2)}catch{return s}};
const jparse=t=>JSON.parse(String(t).trim().replace(/^```(?:json)?\s*/i,'').replace(/\s*```$/,''));
const slug=s=>(String(s).toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_+|_+$/g,'')||'tool').replace(/^(\d)/,'t$1').slice(0,40);
const fit=el=>{el.style.height='auto';el.style.height=Math.min(el.scrollHeight,140)+'px'};
const bottom=()=>{chatEl.scrollTop=chatEl.scrollHeight};
const fmtD=t=>{const d=new Date(t),n=new Date();return d.toDateString()===n.toDateString()?d.toTimeString().slice(0,5):String(d.getDate()).padStart(2,'0')+'.'+String(d.getMonth()+1).padStart(2,'0')};

